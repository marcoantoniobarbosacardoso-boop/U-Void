        "# Questão 4:\n",
        "\n",
        "numero = int(input(\"Digite um número inteiro positivo: \"))\n",
        "if numero < 0:\n",
        "    print(\"Por favor, digite um número maior ou igual a zero.\")\n",
        "else:\n",
        "    fatorial = 1\n",
        "    for i in range(1, numero + 1):\n",
        "        fatorial *= i\n",
        "    print(f\"Fatorial = {fatorial}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5XmaS8MyOufv",

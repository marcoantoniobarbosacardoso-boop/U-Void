    {
      "cell_type": "code",
      "source": [
        "Número = 288\n",
        ",00\n",
        "\n",
        "# Calculadora Simples:\n",
        "\n",
        "# O programa  receber dois números e irá realizar uma das 4 operações matemáticas.\n",
        "\n",
        "opção = \"\"\n",
        "número_a = 0\n",
        "número_b = 0\n",
        "\n",
        "print (\"------ MENU ------\")\n",
        "print (\"\")\n",
        "print (\"Opção 1: Depositar dinheiro\")\n",
        "print (\"\")\n",
        "print (\"Opção 2: Retirar dinheiro\")\n",
        "print (\"\")\n",
        "print (\"Opção 3: Sair\")\n",
        "print (\"\")\n",
        "print (\"======================\")\n",
        "print (\"\")\n",
        "\n",
        "try:\n",
        "\n",
        "  while opção != 3:\n",
        "    opção = int (input(\"Digite a opção desejada ou 3 para sair. \"))\n",
        "    print (\"\")\n",
        "\n",
        "\n",
        "    if opção == 1:\n",
        "      número_a = float (input(\"Digite um número: \"))\n",
        "      print (\"\")\n",
        "      número_b = float (input(\"Digite um número: \"))\n",
        "      print (\"\")\n",
        "      print (f\"Seu novo saldo é {número_a + número_b} \")\n",
        "      print (\"\")\n",
        "\n",
        "    elif opção == 2:\n",
        "      número_a = float (input(\"Digite um número: \"))\n",
        "      print (\"\")\n",
        "      número_b = float (input(\"Digite um número: \"))\n",
        "      print (\"\")\n",
        "      print (f\"Seu novo saldo é: {número_a - número_b} \")\n",
        "      print (\"\")\n",
        "\n",
        "except:\n",
        "  print (\"Digite apenas número de 1 a 2.\")"
      ],
